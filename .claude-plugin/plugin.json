{
  "name": "paqad",
  "displayName": "paqad",
  "description": "Your team's rules, enforced at edit time, with evidence for every change.",
  "version": "1.104.0",
  "author": {
    "name": "Eliyce",
    "email": "hello@eliyce.com",
    "url": "https://eliyce.com"
  },
  "homepage": "https://paqad.ai",
  "repository": "https://github.com/Eliyce/paqad-claude-plugin",
  "license": "MIT",
  "keywords": [
    "governance",
    "code-review",
    "evidence",
    "rules",
    "quality-gates",
    "compliance"
  ],
  "icon": "./assets/icon.png",
  "documentationUrl": "https://paqad.ai/docs/",
  "supportUrl": "https://paqad.ai/support/",
  "privacyPolicyUrl": "https://paqad.ai/privacy/",
  "termsOfServiceUrl": "https://paqad.ai/terms/",
  "hooks": "./runtime/claude-plugin/hooks.json",
  "agents": [
    "./runtime/claude-plugin/agents/paqad-planning.md",
    "./runtime/claude-plugin/agents/paqad-specification.md",
    "./runtime/claude-plugin/agents/paqad-development.md",
    "./runtime/claude-plugin/agents/paqad-review.md",
    "./runtime/claude-plugin/agents/paqad-checks.md",
    "./runtime/claude-plugin/agents/paqad-documentation-sync.md",
    "./runtime/claude-plugin/agents/paqad-expert.md",
    "./runtime/claude-plugin/agents/paqad-chief-architect.md"
  ],
  "skills": "./runtime/claude-plugin/skills",
  "types": "./runtime/claude-plugin/mod/types/index.d.ts",
  "userConfig": {
    "openai_api_key": {
      "type": "string",
      "title": "OpenAI API key",
      "description": "Only needed if you set rag_embedding_provider=openai. Stored in your system credential store.",
      "sensitive": true,
      "required": false
    },
    "cohere_api_key": {
      "type": "string",
      "title": "Cohere API key",
      "description": "Only needed if you turn on reranking with the cohere backend. Stored in your system credential store.",
      "sensitive": true,
      "required": false
    }
  }
}
