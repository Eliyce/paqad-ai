# paqad framework configuration — catalog of every knob (.paqad/.config.example)
# catalog_version: 1
#
# The reference for personal overrides: every setting, with its default, a one-line
# explanation and its PAQAD_* env equivalent, grouped by its team YAML file. This
# file is NEVER read at runtime. To override a setting for yourself, copy its line
# into your git-ignored .config, uncomment it and set a value. To change it for the
# team, set it at the YAML file and path named above it (see configs/README.md).
#
# Precedence, highest first: PAQAD_* env var > .config (personal) > configs/*.yaml
# (team) > code default. With nothing set anywhere, every setting is at the
# default shown below — identical to a fresh install.

# ── paqad.yaml ──────────────────────────────────────────────
# paqad.yaml: enabled
# Turns paqad on or off for this project, and false lets you work without paqad. (env: PAQAD_ENABLE)
# paqad_enable=true
# paqad.yaml: team_bootstrap.enabled
# Lets teammates and Claude Code cloud sessions set paqad up from this repo on their own. (env: PAQAD_TEAM_BOOTSTRAP_ENABLED)
# team_bootstrap_enabled=true
# paqad.yaml: updates.automatic
# Pulls newer paqad versions in the background when a session starts. (env: PAQAD_AUTO_UPDATE)
# auto_update=true
# paqad.yaml: updates.minimum_version
# The lowest paqad version this project runs on, where latest always tracks the newest version. (env: PAQAD_MINIMUM_VERSION)
# minimum_version=latest
# paqad.yaml: updates.check_every_hours
# How many hours pass between background checks for a newer paqad version. (env: PAQAD_VERSION_CHECK_INTERVAL_HOURS)
# version_check_interval_hours=12
# paqad.yaml: site_map.enabled
# Keeps a checked map of the app's screens and user journeys under docs/site-map/ for coding projects. (env: PAQAD_SITE_MAP)
# site_map=false
# paqad.yaml: hud.band
# Shows the paqad status band above the prompt in the Claude Code plugin, along with the /paqad command. (env: PAQAD_HUD_VIEW)
# hud_view=true
# paqad.yaml: hud.chime
# Plays a short chime in the Claude Code plugin once each verdict lands. (env: PAQAD_HUD_CHIME)
# hud_chime=false
# paqad.yaml: claude_code.plugin_migration
# Moves existing npm Claude Code users to the paqad plugin in the background, with npm kept as the fallback. (env: PAQAD_PLUGIN_MIGRATION)
# plugin_migration=off
# paqad.yaml: claude_code.install_mode
# How this project installs paqad into Claude Code, where auto follows the plugin migration switch, plugin forces the plugin and settings keeps the npm hooks. (env: PAQAD_CLAUDE_INSTALL_MODE)
# claude_install_mode=auto

# ── models.yaml ─────────────────────────────────────────────
# models.yaml: models.default
# The model used for routine work. (env: PAQAD_MODEL_DEFAULT)
# model_default=gpt-5
# models.yaml: models.reasoning
# The model used for heavy reasoning and planning. (env: PAQAD_MODEL_REASONING)
# model_reasoning=gpt-5
# models.yaml: models.fast
# The cheap, fast model used for light steps. (env: PAQAD_MODEL_FAST)
# model_fast=gpt-5-mini

# ── retrieval.yaml ──────────────────────────────────────────
# retrieval.yaml: enabled
# Loads relevant code and docs into context through search. (env: PAQAD_RAG_ENABLED)
# rag_enabled=false
# retrieval.yaml: embeddings.provider
# Which embedding service builds the search index, and the local model is used when it is left unset. (env: PAQAD_RAG_EMBEDDING_PROVIDER)
# rag_embedding_provider=
# retrieval.yaml: embeddings.model
# The embedding model to use instead of the default model of the provider. (env: PAQAD_RAG_EMBEDDING_MODEL)
# rag_embedding_model=
# retrieval.yaml: match.min_similarity
# How similar (0 to 1) a piece of code or docs must be to the request before it is loaded. (env: PAQAD_RAG_SIMILARITY_THRESHOLD)
# rag_similarity_threshold=0.75
# retrieval.yaml: match.fallback_min_similarity
# A lower similarity score used when nothing reaches the main one, and the pieces it lets through are marked low confidence. (env: PAQAD_RAG_RELIEF_FLOOR)
# rag_relief_floor=0.35
# retrieval.yaml: match.max_results
# The most pieces of code or docs loaded for one search. (env: PAQAD_RAG_TOP_N)
# rag_top_n=20
# retrieval.yaml: index.max_file_size_bytes
# Files larger than this many bytes are left out of the search index. (env: PAQAD_RAG_MAX_FILE_SIZE)
# rag_max_file_size=153600
# retrieval.yaml: index.base_branch
# The base branch the search index compares against, found on its own (main, then master) when left unset. (env: PAQAD_RAG_BASE_BRANCH)
# rag_base_branch=

# ── decisions.yaml ──────────────────────────────────────────
# decisions.yaml: ask
# How often paqad stops to ask you instead of making a choice itself. (env: PAQAD_DECISIONS_ASK_THRESHOLD)
# decisions_ask_threshold=strict

# ── authoring.yaml ──────────────────────────────────────────
# authoring.yaml: skills.enabled
# Turns on the checks and pipeline paqad runs when a skill is written or changed. (env: PAQAD_SKILL_ORCHESTRATOR_ENABLED)
# skill_orchestrator_enabled=true
# authoring.yaml: skills.trigger_threshold
# The share of test queries (0 to 1) a skill description must handle correctly to pass its trigger test. (env: PAQAD_AUTHORING_TRIGGER_THRESHOLD)
# authoring_trigger_threshold=0.9
# authoring.yaml: skills.trigger_min_runs
# How many of the three runs of each test query must fire the skill. (env: PAQAD_AUTHORING_TRIGGER_MIN_RUNS)
# authoring_trigger_min_runs=2
# authoring.yaml: skills.eval_min_gain_points
# How many percentage points a skill must raise the pass rate over running without it. (env: PAQAD_SKILL_EVAL_MIN_GAIN_POINTS)
# skill_eval_min_gain_points=10
# authoring.yaml: skills.eval_max_token_multiple
# The most tokens a skill run may use, as a multiple of a run without the skill. (env: PAQAD_SKILL_EVAL_MAX_TOKEN_MULTIPLE)
# skill_eval_max_token_multiple=2
# authoring.yaml: runs.per_arm
# How many times each eval case runs with the skill and without it. (env: PAQAD_AUTHORING_RUNS_PER_ARM)
# authoring_runs_per_arm=3
# authoring.yaml: runs.max_iterations
# The most revision rounds an eval loop runs before it stops. (env: PAQAD_AUTHORING_MAX_ITERATIONS)
# authoring_max_iterations=3
# authoring.yaml: skills.fact_max_age_days
# Days a checked outside fact in the sources of a skill stays fresh before release asks for a recheck. (env: PAQAD_AUTHORING_FACT_MAX_AGE_DAYS)
# authoring_fact_max_age_days=60
# authoring.yaml: skills.collision_jaccard
# How much word overlap (0 to 1) a new skill may have with an installed one before it counts as a clash. (env: PAQAD_AUTHORING_COLLISION_JACCARD)
# authoring_collision_jaccard=0.4
# authoring.yaml: skills.description_budget_chars
# The total characters of all installed skill descriptions before release warns that some may be dropped. (env: PAQAD_AUTHORING_DESCRIPTION_BUDGET_CHARS)
# authoring_description_budget_chars=8000
# authoring.yaml: skills.body_max_tokens
# The most tokens the body of a skill file may hold. (env: PAQAD_SKILL_BODY_MAX_TOKENS)
# skill_body_max_tokens=5000
# authoring.yaml: runs.tool_result_max_tokens
# A tool result larger than this many tokens is flagged as too large in an eval run. (env: PAQAD_AUTHORING_TOOL_RESULT_MAX_TOKENS)
# authoring_tool_result_max_tokens=10000
# authoring.yaml: runs.cache_hit_min
# The share of cache hits (0 to 1) below which an eval run is recorded as slow. (env: PAQAD_AUTHORING_CACHE_HIT_MIN)
# authoring_cache_hit_min=0.7
# authoring.yaml: skills.regression_tolerance
# How far (0 to 1) the pass rate of a changed skill may fall below the old version before it fails. (env: PAQAD_AUTHORING_REGRESSION_TOLERANCE)
# authoring_regression_tolerance=0.2
# authoring.yaml: skills.dark_window_days
# Days without a firing before a skill is reported as unused. (env: PAQAD_AUTHORING_DARK_WINDOW_DAYS)
# authoring_dark_window_days=30
# authoring.yaml: runs.batch
# Whether trigger test queries are sent as one batch when the host offers it. (env: PAQAD_AUTHORING_BATCH_MODE)
# authoring_batch_mode=auto
# authoring.yaml: runs.max_cost_usd
# The most US dollars one eval or trigger run may spend before it stops and counts as failed. (env: PAQAD_AUTHORING_RUN_MAX_COST_USD)
# authoring_run_max_cost_usd=5
# authoring.yaml: runs.otel_endpoint
# An OpenTelemetry address to also read usage numbers from, where empty reads them from the host only and paqad never sends transcripts there. (env: PAQAD_AUTHORING_OTEL_ENDPOINT)
# authoring_otel_endpoint=
# authoring.yaml: agents.enabled
# Turns on the checks and pipeline paqad runs when a helper agent is written or changed. (env: PAQAD_AGENT_ORCHESTRATOR_ENABLED)
# agent_orchestrator_enabled=true
# authoring.yaml: agents.pass_k_threshold
# The score (0 to 1) an agent must reach when each of its eval cases runs three times. (env: PAQAD_AGENT_PASS_K_THRESHOLD)
# agent_pass_k_threshold=0.9
# authoring.yaml: agents.stage_pass_k_threshold
# The score (0 to 1) an unattended stage agent must reach when each of its eval cases runs three times. (env: PAQAD_AGENT_STAGE_PASS_K_THRESHOLD)
# agent_stage_pass_k_threshold=0.95
# authoring.yaml: agents.delegation_threshold
# The share of test requests (0 to 1) an agent description must route to the agent correctly. (env: PAQAD_AGENT_DELEGATION_THRESHOLD)
# agent_delegation_threshold=0.9
# authoring.yaml: agents.description_max_tokens
# The most tokens an agent description may hold. (env: PAQAD_AGENT_DESCRIPTION_MAX_TOKENS)
# agent_description_max_tokens=300
# authoring.yaml: agents.report_max_tokens
# The most tokens an agent report may hold when the agent names no smaller limit. (env: PAQAD_AGENT_REPORT_MAX_TOKENS)
# agent_report_max_tokens=2000
# authoring.yaml: agents.prompt_max_tokens
# The most tokens the instructions of an agent may hold. (env: PAQAD_AGENT_PROMPT_MAX_TOKENS)
# agent_prompt_max_tokens=3000
# authoring.yaml: agents.max_tools
# The most tools an agent may list before it needs an approval. (env: PAQAD_AGENT_MAX_TOOLS)
# agent_max_tools=10
# authoring.yaml: agents.max_cost_multiple
# The most an agent run may cost, as a multiple of doing the work in the main session, unless it saves time by running in parallel. (env: PAQAD_AGENT_MAX_COST_MULTIPLE)
# agent_max_cost_multiple=4
# authoring.yaml: agents.catalog_description_max_tokens
# The most tokens all installed agent descriptions may hold together. (env: PAQAD_AGENT_CATALOG_DESCRIPTION_MAX_TOKENS)
# agent_catalog_description_max_tokens=15000
# authoring.yaml: agents.memory_max_lines
# The most lines the memory file of an agent may hold. (env: PAQAD_AGENT_MEMORY_MAX_LINES)
# agent_memory_max_lines=200

# ── feature-development/workflow.yaml ───────────────────────
# feature-development/workflow.yaml: stop_after
# Stops a change once the spec is written, so nothing is implemented. (env: PAQAD_SPEC_ONLY_MODE)
# spec_only_mode=false
# feature-development/workflow.yaml: stages.planning.research.market
# Runs the market research helper during planning. (env: PAQAD_MARKET_RESEARCH)
# market_research=false
# feature-development/workflow.yaml: stages.planning.research.design
# Runs the design research helper during planning. (env: PAQAD_DESIGN_RESEARCH)
# design_research=false
# feature-development/workflow.yaml: stage_helpers.team_agents
# Uses a team of helper agents for work on the full lane. (env: PAQAD_TEAM_AGENTS)
# team_agents=true
# feature-development/workflow.yaml: stages.planning.effort
# How hard the planning stage helper thinks, where inherit uses the effort of the main session and `paqad-ai stage settings` applies a change. (env: PAQAD_STAGE_EFFORT_PLANNING)
# stage_effort_planning=high
# feature-development/workflow.yaml: stages.planning.model
# The model the planning stage helper runs on, where inherit uses the model of the main session and `paqad-ai stage settings` applies a change. (env: PAQAD_STAGE_MODEL_PLANNING)
# stage_model_planning=inherit
# feature-development/workflow.yaml: stages.specification.effort
# How hard the specification stage helper thinks, where inherit uses the effort of the main session and `paqad-ai stage settings` applies a change. (env: PAQAD_STAGE_EFFORT_SPECIFICATION)
# stage_effort_specification=high
# feature-development/workflow.yaml: stages.specification.model
# The model the specification stage helper runs on, where inherit uses the model of the main session and `paqad-ai stage settings` applies a change. (env: PAQAD_STAGE_MODEL_SPECIFICATION)
# stage_model_specification=inherit
# feature-development/workflow.yaml: stages.development.effort
# How hard the development stage helper thinks, where inherit uses the effort of the main session and `paqad-ai stage settings` applies a change. (env: PAQAD_STAGE_EFFORT_DEVELOPMENT)
# stage_effort_development=inherit
# feature-development/workflow.yaml: stages.development.model
# The model the development stage helper runs on, where inherit uses the model of the main session and `paqad-ai stage settings` applies a change. (env: PAQAD_STAGE_MODEL_DEVELOPMENT)
# stage_model_development=inherit
# feature-development/workflow.yaml: stages.review.effort
# How hard the review stage helper thinks, where inherit uses the effort of the main session and `paqad-ai stage settings` applies a change, and a lighter review catches less. (env: PAQAD_STAGE_EFFORT_REVIEW)
# stage_effort_review=high
# feature-development/workflow.yaml: stages.review.model
# The model the review stage helper runs on, where inherit uses the model of the main session and `paqad-ai stage settings` applies a change. (env: PAQAD_STAGE_MODEL_REVIEW)
# stage_model_review=inherit
# feature-development/workflow.yaml: stages.checks.effort
# How hard the checks stage helper thinks, where inherit uses the effort of the main session and `paqad-ai stage settings` applies a change. (env: PAQAD_STAGE_EFFORT_CHECKS)
# stage_effort_checks=low
# feature-development/workflow.yaml: stages.checks.model
# The model the checks stage helper runs on, where inherit uses the model of the main session and `paqad-ai stage settings` applies a change. (env: PAQAD_STAGE_MODEL_CHECKS)
# stage_model_checks=inherit
# feature-development/workflow.yaml: stages.documentation_sync.effort
# How hard the documentation_sync stage helper thinks, where inherit uses the effort of the main session and `paqad-ai stage settings` applies a change. (env: PAQAD_STAGE_EFFORT_DOCUMENTATION_SYNC)
# stage_effort_documentation_sync=low
# feature-development/workflow.yaml: stages.documentation_sync.model
# The model the documentation_sync stage helper runs on, where inherit uses the model of the main session and `paqad-ai stage settings` applies a change. (env: PAQAD_STAGE_MODEL_DOCUMENTATION_SYNC)
# stage_model_documentation_sync=inherit
# feature-development/workflow.yaml: stage_tracking
# How firmly paqad checks that every feature-development stage was run and recorded. (env: PAQAD_STAGES_MODE)
# stages_mode=strict
# feature-development/workflow.yaml: stage_helpers.on_lanes
# The lanes on which each feature-development stage runs in its own helper agent, and full is always included. (env: PAQAD_STAGE_ISOLATION_LANES)
# stage_isolation_lanes=full

# ── feature-development/specification.yaml ──────────────────
# feature-development/specification.yaml: pipeline.enabled
# Writes the spec through the grounded spec pipeline on the graduated and full lanes. (env: PAQAD_SPEC_PIPELINE_ENABLED)
# spec_pipeline_enabled=true
# feature-development/specification.yaml: questions
# How firmly the spec pipeline asks about an unclear request, from never asking to holding until you answer. (env: PAQAD_SPEC_PIPELINE_CLARIFICATION)
# spec_pipeline_clarification=warn
# feature-development/specification.yaml: final_review
# Whether a person must read and approve the spec before it is frozen. (env: PAQAD_SPEC_PIPELINE_FINAL_REVIEW)
# spec_pipeline_final_review=off
# feature-development/specification.yaml: pipeline.max_tokens
# The model tokens one spec pipeline run may use before paqad records a warning. (env: PAQAD_SPEC_PIPELINE_TOKEN_CEILING)
# spec_pipeline_token_ceiling=40000
# feature-development/specification.yaml: pipeline.grounding_timeout_ms
# Milliseconds the spec pipeline gives search to ground a request before it grounds on the docs alone. (env: PAQAD_SPEC_GROUNDING_BUDGET_MS)
# spec_grounding_budget_ms=15000
# feature-development/specification.yaml: experts.enabled
# Seats the experts a request needs, such as database or security, and adds their notes to the spec. (env: PAQAD_SPEC_PIPELINE_EXPERTS_ENABLED)
# spec_pipeline_experts_enabled=true
# feature-development/specification.yaml: hand_written_specs
# Whether the specification stage refuses a hand-written spec or only records that the pipeline did not write it. (env: PAQAD_SPEC_PIPELINE_ADOPTION)
# spec_pipeline_adoption=strict
# feature-development/specification.yaml: experts.standing_on_lanes
# The lanes on which the standing experts join every spec, and full is always included. (env: PAQAD_SPEC_PIPELINE_EXPERTS_LANES)
# spec_pipeline_experts_lanes=full
# feature-development/specification.yaml: experts.standing
# The expert roles that join every spec run, whatever the request needs. (env: PAQAD_SPEC_PIPELINE_STANDING_EXPERTS)
# spec_pipeline_standing_experts=product-owner,application-architect,user-flow-writer,qa-engineer

# ── feature-development/rules.yaml ──────────────────────────
# feature-development/rules.yaml: loading
# Loads only the rule text that applies to the files in play, instead of every rule in full each session. (env: PAQAD_LEAN_RULES)
# lean_rules=true
# feature-development/rules.yaml: enforcement
# How firmly the scripted project rules are enforced on the working tree. (env: PAQAD_RULE_COMPLIANCE)
# rule_compliance=warn
# feature-development/rules.yaml: before_edit.run
# Which rule scripts run before an edit, either only the fast blocking ones or all of them. (env: PAQAD_RULE_GATE_PRE_EDIT)
# rule_gate_pre_edit=blocking-only
# feature-development/rules.yaml: max_parallel
# How many rule scripts run at once, from 1 to 8, where auto uses the CPU cores minus one. (env: PAQAD_RULE_GATE_CONCURRENCY)
# rule_gate_concurrency=auto
# feature-development/rules.yaml: before_edit.budget_ms
# Milliseconds (500 to 9000) the rule check before an edit may take, after which the edit goes ahead and the checks run at turn end. (env: PAQAD_RULE_GATE_BUDGET_MS)
# rule_gate_budget_ms=6000

# ── feature-development/reuse.yaml ──────────────────────────
# feature-development/reuse.yaml: existing_code_digest.max_tokens
# The token budget for the list of existing code that planning asks the model to reuse. (env: PAQAD_EXISTING_SURFACE_TOKENS)
# existing_surface_tokens=1000
# feature-development/reuse.yaml: duplication.gate
# How paqad treats new code that nearly copies existing code, from a warning to a block. (env: PAQAD_DUPLICATION_MODE)
# duplication_mode=warn
# feature-development/reuse.yaml: duplication.min_similarity
# How similar (0 to 1) new code must be to existing code before the duplication check blocks it. (env: PAQAD_DUPLICATION_SIMILARITY_THRESHOLD)
# duplication_similarity_threshold=0.9
# feature-development/reuse.yaml: duplication.min_lines
# The fewest meaningful lines a new block of code needs before it is checked for duplication. (env: PAQAD_DUPLICATION_MIN_LINES)
# duplication_min_lines=8
# feature-development/reuse.yaml: create_vs_reuse.pause
# How paqad handles a planned new piece of code that looks like existing code, from a report to a pause that waits for your answer. (env: PAQAD_DECISION_ARM_MODE)
# decision_arm_mode=warn
# feature-development/reuse.yaml: create_vs_reuse.min_similarity
# How similar (0 to 1) a planned new name must be to an existing one before paqad asks whether to reuse it. (env: PAQAD_DECISION_ARM_PLAN_THRESHOLD)
# decision_arm_plan_threshold=0.85
# feature-development/reuse.yaml: create_vs_reuse.max_pauses_per_change
# The most reuse pauses one change may open, with the rest reported as warnings. (env: PAQAD_DECISION_ARM_MAX_PER_CHANGE)
# decision_arm_max_per_change=1

# ── feature-development/checks.yaml ─────────────────────────
# feature-development/checks.yaml: parallel
# Runs the checks at the same time, using the test runner's own parallel mode when it has one. (env: PAQAD_CHECKS_PARALLEL)
# checks_parallel=true
# feature-development/checks.yaml: max_processes
# The most test processes that run at once, where auto uses the CPU cores minus one within memory limits. (env: PAQAD_CHECKS_MAX_PROCESSES)
# checks_max_processes=0
# feature-development/checks.yaml: mutation_testing
# Mutation testing on changed code, which runs only from the CI or pre-push hook of the project with its own mutation tool. (env: PAQAD_MUTATION_MODE)
# mutation_mode=off
# feature-development/checks.yaml: flaky_tests
# What happens to a test that fails in the parallel run but passes alone, and a personal setting may only make it stricter. (env: PAQAD_CHECKS_FLAKY_UNDER_PARALLEL)
# checks_flaky_under_parallel=warn

# ── feature-development/evidence.yaml ───────────────────────
# feature-development/evidence.yaml: enterprise.enabled
# Turns on the enterprise and governance outputs as a group. (env: PAQAD_ENTERPRISE)
# enterprise=false
# feature-development/evidence.yaml: enterprise.ledger
# Writes the receipt and evidence ledger for each change under .paqad/ledger/. (env: PAQAD_ENTERPRISE_EVIDENCE_LEDGER)
# enterprise_evidence_ledger=false
# feature-development/evidence.yaml: enterprise.ai_bom
# Writes an AI bill of materials (ai-bom.json, in CycloneDX format) for each change. (env: PAQAD_ENTERPRISE_AI_BOM)
# enterprise_ai_bom=false
# feature-development/evidence.yaml: enterprise.compliance_citations
# Adds compliance framework citations to the receipt, which spends extra tokens. (env: PAQAD_ENTERPRISE_COMPLIANCE_CITATIONS)
# enterprise_compliance_citations=false
# feature-development/evidence.yaml: screenshots.enabled
# Captures screenshots of documented flows as proof for frontend changes in coding projects. (env: PAQAD_VISUAL_EVIDENCE)
# visual_evidence=false
# feature-development/evidence.yaml: report
# Writes a local evidence report page for each change when it finishes, at no model cost. (env: PAQAD_FEATURE_REPORT)
# feature_report=true
# feature-development/evidence.yaml: change_metrics
# Measures duplication and reuse in the new code of each change and shows them on the receipt and dashboard. (env: PAQAD_METRICS_ENABLED)
# metrics_enabled=true
# feature-development/evidence.yaml: bundle
# How firmly paqad checks at the end of a change that its evidence bundle holds every required file. (env: PAQAD_BUNDLE_COMPLETENESS)
# bundle_completeness=strict
# feature-development/evidence.yaml: screenshots.gate
# How firmly the screenshot check holds a frontend change with missing screenshots, and a personal setting may only make it stricter. (env: PAQAD_VISUAL_EVIDENCE_MODE)
# visual_evidence_mode=warn
# feature-development/evidence.yaml: legacy_existence_check
# An older evidence check that runs only while the bundle check is off and never blocks a change. (env: PAQAD_EVIDENCE_EXISTENCE_GATE)
# evidence_existence_gate=warn

# ── feature-development/analytics.yaml ──────────────────────
# feature-development/analytics.yaml: enabled
# Lets paqad wire analytics tracking into the app and keep a tracking plan doc for each event. (env: PAQAD_ANALYTICS_INSTRUMENTATION)
# analytics_instrumentation=false
# feature-development/analytics.yaml: gate
# How firmly paqad checks that each analytics event has its tracking plan doc. (env: PAQAD_ANALYTICS_STRICTNESS)
# analytics_strictness=warn

# ── git-workflow/commits.yaml ───────────────────────────────
# git-workflow/commits.yaml: ai_attribution
# Whether the attribution of the coding agent stays on your commits and pull requests, while the paqad delivery footer is never changed. (env: PAQAD_AI_ATTRIBUTION)
# ai_attribution=strip
