# paqad framework configuration — catalog of every knob (.paqad/.config.example)
# generated by paqad-ai 1.116.0
#
# The reference for personal overrides: every setting, with its default, a one-line
# explanation and its PAQAD_* env equivalent, grouped by its team YAML file. This
# file is NEVER read at runtime. To override a setting for yourself, copy its line
# into your git-ignored .config, uncomment it and set a value. To change it for the
# team, set it at the YAML file and path named above it (see configs/README.md).
#
# Precedence, highest first: PAQAD_* env var > .config (personal) > configs/*.yaml
# (team) > code default. With nothing set anywhere, every setting is at the
# default shown below — identical to a fresh install.

# ── paqad.yaml ──────────────────────────────────────────────
# paqad.yaml: enabled
# Turn paqad off entirely (vanilla mode). Absent/true = on. (env: PAQAD_ENABLE)
# paqad_enable=true
# paqad.yaml: team_bootstrap.enabled
# Let teammates and Claude Code cloud sessions set paqad up from this repo on their own. false = onboarding writes no team setup and the launcher does nothing. (env: PAQAD_TEAM_BOOTSTRAP_ENABLED)
# team_bootstrap_enabled=true
# paqad.yaml: updates.automatic
# Pull newer framework versions in the background on session start. (env: PAQAD_AUTO_UPDATE)
# auto_update=true
# paqad.yaml: updates.minimum_version
# Refuse to run below this version. "latest" = no fixed floor, track newest. Or pin e.g. 1.28.1. (env: PAQAD_MINIMUM_VERSION)
# minimum_version=latest
# paqad.yaml: updates.check_every_hours
# How often the background version check runs. (env: PAQAD_VERSION_CHECK_INTERVAL_HOURS)
# version_check_interval_hours=12
# paqad.yaml: site_map.enabled
# Opt in to the Site Map & Journeys capability — a verified behavioural map of the app stored at docs/site-map/ (the Site map dashboard area + `site-map` workflow). OFF (default) is completely inert; ON also requires the coding capability at its consumers. (env: PAQAD_SITE_MAP)
# site_map=false
# paqad.yaml: hud.band
# Show the paqad HUD band above the prompt in the Claude Code plugin. OFF shows no band and registers no /paqad command. (env: PAQAD_HUD_VIEW)
# hud_view=true
# paqad.yaml: hud.chime
# Play a short chime in the Claude Code plugin when the verdict lands, once per verdict. A chime only, never speech. (env: PAQAD_HUD_CHIME)
# hud_chime=false
# paqad.yaml: claude_code.plugin_migration
# on | off — fleet-wide switch to move existing npm Claude Code users to the paqad plugin automatically in the background. Default off until manual sign-off; Claude Code only, npm is never removed and stays the fallback. (env: PAQAD_PLUGIN_MIGRATION)
# plugin_migration=off
# paqad.yaml: claude_code.install_mode
# auto | plugin | settings — per-project override of the plugin migration. settings never migrates (stay on npm hooks); set in a tracked configs file it also keeps the plugin out of the shared .claude/settings.json. plugin forces the migration even while plugin_migration is off; auto follows plugin_migration. (env: PAQAD_CLAUDE_INSTALL_MODE)
# claude_install_mode=auto

# ── models.yaml ─────────────────────────────────────────────
# models.yaml: research.depth
# cutting-edge | standard | conservative. (env: PAQAD_RESEARCH_DEPTH)
# research_depth=standard
# models.yaml: models.default
# Default model for routine work. (env: PAQAD_MODEL_DEFAULT)
# model_default=gpt-5
# models.yaml: models.reasoning
# Model for heavy reasoning / planning. (env: PAQAD_MODEL_REASONING)
# model_reasoning=gpt-5
# models.yaml: models.fast
# Cheap/fast model for lightweight steps. (env: PAQAD_MODEL_FAST)
# model_fast=gpt-5-mini

# ── retrieval.yaml ──────────────────────────────────────────
# retrieval.yaml: enabled
# Enable retrieval-augmented context loading. (env: PAQAD_RAG_ENABLED)
# rag_enabled=false
# retrieval.yaml: embeddings.provider
# local | openai. Unset uses the local model. (env: PAQAD_RAG_EMBEDDING_PROVIDER)
# rag_embedding_provider=
# retrieval.yaml: embeddings.model
# Override the embedding model id. Unset = provider default. (env: PAQAD_RAG_EMBEDDING_MODEL)
# rag_embedding_model=
# retrieval.yaml: match.min_similarity
# Minimum cosine similarity for a chunk to be retrieved. (env: PAQAD_RAG_SIMILARITY_THRESHOLD)
# rag_similarity_threshold=0.75
# retrieval.yaml: match.fallback_min_similarity
# Relief band for floor-with-relief. When nothing clears rag_similarity_threshold, the top slices at or above this lower score are delivered tagged low-confidence. (env: PAQAD_RAG_RELIEF_FLOOR)
# rag_relief_floor=0.35
# retrieval.yaml: match.max_results
# Max chunks retrieved per query. (env: PAQAD_RAG_TOP_N)
# rag_top_n=20
# retrieval.yaml: index.max_file_size_bytes
# Skip indexing files larger than this many bytes. (env: PAQAD_RAG_MAX_FILE_SIZE)
# rag_max_file_size=153600
# retrieval.yaml: index.base_branch
# Base branch for branch-aware RAG. Unset auto-detects main->master. (env: PAQAD_RAG_BASE_BRANCH)
# rag_base_branch=

# ── decisions.yaml ──────────────────────────────────────────
# decisions.yaml: ask
# strict | balanced | permissive — how eagerly to pause and ask. (env: PAQAD_DECISIONS_ASK_THRESHOLD)
# decisions_ask_threshold=strict
# decisions.yaml: max_screens_per_change
# Max decision screens surfaced per task. (env: PAQAD_DECISIONS_MAX_SCREENS_PER_TASK)
# decisions_max_screens_per_task=3
# decisions.yaml: auto_resolve_after_minutes
# Auto-resolve a pending decision after this idle window. (env: PAQAD_DECISIONS_IDLE_TIMEOUT_MINUTES)
# decisions_idle_timeout_minutes=30

# ── authoring.yaml ──────────────────────────────────────────
# authoring.yaml: skills.enabled
# Turn the Skill Orchestrator on or off. Off means no High Table seat on skill paths, no skill pipeline, no lane raise for skills and no skill completion check, so a skill edit is judged as before. (env: PAQAD_SKILL_ORCHESTRATOR_ENABLED)
# skill_orchestrator_enabled=true
# authoring.yaml: skills.trigger_threshold
# S6 trigger test: the validation pass rate a skill description needs, from 0 to 1. (env: PAQAD_AUTHORING_TRIGGER_THRESHOLD)
# authoring_trigger_threshold=0.9
# authoring.yaml: skills.trigger_min_runs
# S6 trigger test: how many of the 3 runs of each query must fire the skill. A positive whole number. (env: PAQAD_AUTHORING_TRIGGER_MIN_RUNS)
# authoring_trigger_min_runs=2
# authoring.yaml: skills.eval_min_gain_points
# S5 evals: the pass-rate gain over the no-skill baseline a skill needs, in percentage points. A positive whole number. (env: PAQAD_SKILL_EVAL_MIN_GAIN_POINTS)
# skill_eval_min_gain_points=10
# authoring.yaml: skills.eval_max_token_multiple
# S5 evals: the most median tokens a skill run may use, as a multiple of the baseline. 1 or more. (env: PAQAD_SKILL_EVAL_MAX_TOKEN_MULTIPLE)
# skill_eval_max_token_multiple=2
# authoring.yaml: runs.per_arm
# S5 evals: runs per arm (with and without the skill) for each case. A positive whole number. (env: PAQAD_AUTHORING_RUNS_PER_ARM)
# authoring_runs_per_arm=3
# authoring.yaml: runs.max_iterations
# S5 evals: the most revision rounds before the loop stops. A positive whole number. (env: PAQAD_AUTHORING_MAX_ITERATIONS)
# authoring_max_iterations=3
# authoring.yaml: skills.fact_max_age_days
# Days an externally verified fact in sources.md stays fresh. Older facts block release until rechecked. A positive whole number. (env: PAQAD_AUTHORING_FACT_MAX_AGE_DAYS)
# authoring_fact_max_age_days=60
# authoring.yaml: skills.collision_jaccard
# Overlap check: the word-set similarity (Jaccard, 0 to 1) at which a new skill collides with an installed one. (env: PAQAD_AUTHORING_COLLISION_JACCARD)
# authoring_collision_jaccard=0.4
# authoring.yaml: skills.description_budget_chars
# Overlap check: the total characters of every installed skill description before a release warns that some may be dropped. A positive whole number. (env: PAQAD_AUTHORING_DESCRIPTION_BUDGET_CHARS)
# authoring_description_budget_chars=8000
# authoring.yaml: skills.body_max_tokens
# Lint (SK-008): the most tokens a SKILL.md body may hold. A positive whole number. (env: PAQAD_SKILL_BODY_MAX_TOKENS)
# skill_body_max_tokens=5000
# authoring.yaml: runs.tool_result_max_tokens
# S5 analyst: a tool result above this many tokens is flagged as oversize. A positive whole number. (env: PAQAD_AUTHORING_TOOL_RESULT_MAX_TOKENS)
# authoring_tool_result_max_tokens=10000
# authoring.yaml: runs.cache_hit_min
# S5 analyst: the steady-state cache-hit share (0 to 1) below which a run is recorded as a performance defect. (env: PAQAD_AUTHORING_CACHE_HIT_MIN)
# authoring_cache_hit_min=0.7
# authoring.yaml: skills.regression_tolerance
# S5 in improve mode and S8: how far (0 to 1) the pass rate of an edited or re-evaluated skill may fall below the old version before it fails. (env: PAQAD_AUTHORING_REGRESSION_TOLERANCE)
# authoring_regression_tolerance=0.2
# authoring.yaml: skills.dark_window_days
# S8 catalog: days without a firing before a skill is reported as dark. A positive whole number. (env: PAQAD_AUTHORING_DARK_WINDOW_DAYS)
# authoring_dark_window_days=30
# authoring.yaml: runs.batch
# auto | off. auto lets S6 send its trigger queries as one batch when the host offers it; off always runs them one by one. (env: PAQAD_AUTHORING_BATCH_MODE)
# authoring_batch_mode=auto
# authoring.yaml: runs.max_cost_usd
# Spend cap in US dollars for one eval or trigger sweep, passed as --max-cost-usd. A capped run counts as a failure and is recorded as partial. Above 0. (env: PAQAD_AUTHORING_RUN_MAX_COST_USD)
# authoring_run_max_cost_usd=5
# authoring.yaml: runs.otel_endpoint
# Empty reads usage numbers from the host only. An http(s) URL also reads them from that OpenTelemetry endpoint. paqad never sends transcripts to it. (env: PAQAD_AUTHORING_OTEL_ENDPOINT)
# authoring_otel_endpoint=
# authoring.yaml: agents.enabled
# Turn the Agent Orchestrator on or off. Off means no High Table seat on agent paths, no agent pipeline, no lane raise for agents and no agent completion check, so an agent edit is judged as before. (env: PAQAD_AGENT_ORCHESTRATOR_ENABLED)
# agent_orchestrator_enabled=true
# authoring.yaml: agents.pass_k_threshold
# S5 agent evals: the pass^3 score (0 to 1) an agent needs on its task cases. (env: PAQAD_AGENT_PASS_K_THRESHOLD)
# agent_pass_k_threshold=0.9
# authoring.yaml: agents.stage_pass_k_threshold
# S5 agent evals: the pass^3 score (0 to 1) an unattended stage agent needs on its task cases. (env: PAQAD_AGENT_STAGE_PASS_K_THRESHOLD)
# agent_stage_pass_k_threshold=0.95
# authoring.yaml: agents.delegation_threshold
# S6 delegation test: the validation pass rate (0 to 1) an agent description needs. (env: PAQAD_AGENT_DELEGATION_THRESHOLD)
# agent_delegation_threshold=0.9
# authoring.yaml: agents.description_max_tokens
# Lint (AG-003): the most tokens an agent description may hold. A positive whole number. (env: PAQAD_AGENT_DESCRIPTION_MAX_TOKENS)
# agent_description_max_tokens=300
# authoring.yaml: agents.report_max_tokens
# The most tokens an agent report may hold when its Report section names no smaller maximum. A positive whole number. (env: PAQAD_AGENT_REPORT_MAX_TOKENS)
# agent_report_max_tokens=2000
# authoring.yaml: agents.prompt_max_tokens
# Lint (AG-014): the most tokens an agent body (its system prompt) may hold. A positive whole number. (env: PAQAD_AGENT_PROMPT_MAX_TOKENS)
# agent_prompt_max_tokens=3000
# authoring.yaml: agents.max_tools
# Lint (AG-018): the most tools an agent may list before it needs an approval packet. A positive whole number. (env: PAQAD_AGENT_MAX_TOOLS)
# agent_max_tools=10
# authoring.yaml: agents.max_cost_multiple
# S5 agent evals: the most median cost an agent run may use, as a multiple of the main-thread baseline, unless it shows a parallel wall-time gain. 1 or more. (env: PAQAD_AGENT_MAX_COST_MULTIPLE)
# agent_max_cost_multiple=4
# authoring.yaml: agents.catalog_description_max_tokens
# Lint (AG-004): the most tokens all installed agent descriptions may hold together. A positive whole number. (env: PAQAD_AGENT_CATALOG_DESCRIPTION_MAX_TOKENS)
# agent_catalog_description_max_tokens=15000
# authoring.yaml: agents.memory_max_lines
# Lint (AG-010) and memory-consolidate: the most lines an agent MEMORY.md may hold. A positive whole number. (env: PAQAD_AGENT_MEMORY_MAX_LINES)
# agent_memory_max_lines=200

# ── feature-development/workflow.yaml ───────────────────────
# feature-development/workflow.yaml: stop_after
# Stop after the spec phase; do not implement. (env: PAQAD_SPEC_ONLY_MODE)
# spec_only_mode=false
# feature-development/workflow.yaml: stages.planning.research.market
# Enable the market-research agent in planning. (env: PAQAD_MARKET_RESEARCH)
# market_research=false
# feature-development/workflow.yaml: stages.planning.research.design
# Enable the design-research agent in planning. (env: PAQAD_DESIGN_RESEARCH)
# design_research=false
# feature-development/workflow.yaml: stage_helpers.team_agents
# Use the multi-agent team for full-lane work. (env: PAQAD_TEAM_AGENTS)
# team_agents=true
# feature-development/workflow.yaml: stages.planning.effort
# low | medium | high | xhigh | inherit. How hard the planning stage helper thinks. inherit uses the effort of the main session. Run `paqad-ai stage settings` to apply it on the next dispatch; the helper files keep the defaults. (env: PAQAD_STAGE_EFFORT_PLANNING)
# stage_effort_planning=high
# feature-development/workflow.yaml: stages.planning.model
# inherit | haiku | sonnet | opus. The model the planning stage helper runs on. inherit uses the model of the main session. Run `paqad-ai stage settings` to apply it on the next dispatch; the helper files keep the defaults. (env: PAQAD_STAGE_MODEL_PLANNING)
# stage_model_planning=inherit
# feature-development/workflow.yaml: stages.specification.effort
# low | medium | high | xhigh | inherit. How hard the specification stage helper thinks. inherit uses the effort of the main session. Run `paqad-ai stage settings` to apply it on the next dispatch; the helper files keep the defaults. (env: PAQAD_STAGE_EFFORT_SPECIFICATION)
# stage_effort_specification=high
# feature-development/workflow.yaml: stages.specification.model
# inherit | haiku | sonnet | opus. The model the specification stage helper runs on. inherit uses the model of the main session. Run `paqad-ai stage settings` to apply it on the next dispatch; the helper files keep the defaults. (env: PAQAD_STAGE_MODEL_SPECIFICATION)
# stage_model_specification=inherit
# feature-development/workflow.yaml: stages.development.effort
# low | medium | high | xhigh | inherit. How hard the development stage helper thinks. inherit uses the effort of the main session. Run `paqad-ai stage settings` to apply it on the next dispatch; the helper files keep the defaults. (env: PAQAD_STAGE_EFFORT_DEVELOPMENT)
# stage_effort_development=inherit
# feature-development/workflow.yaml: stages.development.model
# inherit | haiku | sonnet | opus. The model the development stage helper runs on. inherit uses the model of the main session. Run `paqad-ai stage settings` to apply it on the next dispatch; the helper files keep the defaults. (env: PAQAD_STAGE_MODEL_DEVELOPMENT)
# stage_model_development=inherit
# feature-development/workflow.yaml: stages.review.effort
# low | medium | high | xhigh | inherit. How hard the review stage helper thinks. inherit uses the effort of the main session. Run `paqad-ai stage settings` to apply it on the next dispatch; the helper files keep the defaults. You may lower it, but a lighter review catches less. (env: PAQAD_STAGE_EFFORT_REVIEW)
# stage_effort_review=high
# feature-development/workflow.yaml: stages.review.model
# inherit | haiku | sonnet | opus. The model the review stage helper runs on. inherit uses the model of the main session. Run `paqad-ai stage settings` to apply it on the next dispatch; the helper files keep the defaults. (env: PAQAD_STAGE_MODEL_REVIEW)
# stage_model_review=inherit
# feature-development/workflow.yaml: stages.checks.effort
# low | medium | high | xhigh | inherit. How hard the checks stage helper thinks. inherit uses the effort of the main session. Run `paqad-ai stage settings` to apply it on the next dispatch; the helper files keep the defaults. (env: PAQAD_STAGE_EFFORT_CHECKS)
# stage_effort_checks=low
# feature-development/workflow.yaml: stages.checks.model
# inherit | haiku | sonnet | opus. The model the checks stage helper runs on. inherit uses the model of the main session. Run `paqad-ai stage settings` to apply it on the next dispatch; the helper files keep the defaults. (env: PAQAD_STAGE_MODEL_CHECKS)
# stage_model_checks=inherit
# feature-development/workflow.yaml: stages.documentation_sync.effort
# low | medium | high | xhigh | inherit. How hard the documentation_sync stage helper thinks. inherit uses the effort of the main session. Run `paqad-ai stage settings` to apply it on the next dispatch; the helper files keep the defaults. (env: PAQAD_STAGE_EFFORT_DOCUMENTATION_SYNC)
# stage_effort_documentation_sync=low
# feature-development/workflow.yaml: stages.documentation_sync.model
# inherit | haiku | sonnet | opus. The model the documentation_sync stage helper runs on. inherit uses the model of the main session. Run `paqad-ai stage settings` to apply it on the next dispatch; the helper files keep the defaults. (env: PAQAD_STAGE_MODEL_DOCUMENTATION_SYNC)
# stage_model_documentation_sync=inherit
# feature-development/workflow.yaml: lanes.default
# Route every task through the full (heaviest) lane by default. (env: PAQAD_FULL_LANE_DEFAULT)
# full_lane_default=false
# feature-development/workflow.yaml: stages.review.adversarial_pass
# Require an adversarial review pass before delivery. (env: PAQAD_REQUIRE_ADVERSARIAL_REVIEW)
# require_adversarial_review=true
# feature-development/workflow.yaml: stages.documentation_sync.stale_docs
# Block delivery when canonical docs are out of date. (env: PAQAD_BLOCK_ON_STALE_DOCS)
# block_on_stale_docs=true
# feature-development/workflow.yaml: stage_tracking
# off | warn | strict — feature-development stage-completeness gate (default strict). (env: PAQAD_STAGES_MODE)
# stages_mode=strict
# feature-development/workflow.yaml: stage_helpers.on_lanes
# Comma-separated lanes (fast, graduated, full) on which each feature-development stage runs in its own stage helper on a host that can dispatch subagents (Claude Code, Codex). On other lanes the main agent runs every stage itself, with the same stages, artifacts and gates. Default: full. Set graduated,full to restore the old behaviour. full is always included; an empty or unreadable value gives the default. (env: PAQAD_STAGE_ISOLATION_LANES)
# stage_isolation_lanes=full

# ── feature-development/specification.yaml ──────────────────
# feature-development/specification.yaml: pipeline.enabled
# The grounded prompt->spec pipeline (`paqad-ai spec pipeline`). On by default on the graduated and full lanes; the fast lane never runs it. Set it to false to switch it off: feature-development then works as it did before the pipeline (FR-11). It sits upstream of the edit lock and feeds `spec freeze`. (env: PAQAD_SPEC_PIPELINE_ENABLED)
# spec_pipeline_enabled=true
# feature-development/specification.yaml: questions
# off | warn | strict — the switchable clarification (question-round) gate. warn (advisory): ask questions on an unclear prompt but never block. strict (required): ask and hold until answered or explicitly deferred. off: never ask. The fixed spine (grounding, no-invented-requirements, traceability) is never switchable. (env: PAQAD_SPEC_PIPELINE_CLARIFICATION)
# spec_pipeline_clarification=warn
# feature-development/specification.yaml: final_review
# off | warn | strict — the switchable final-review gate before freeze. off: show a non-blocking readable spec. warn (advisory): show and freeze. strict (required): a human must approve before freeze, recording a named human. Independent of the A5 gate. (env: PAQAD_SPEC_PIPELINE_FINAL_REVIEW)
# spec_pipeline_final_review=off
# feature-development/specification.yaml: pipeline.max_tokens
# Per-run model-token ceiling for the spec pipeline. Exceeding it raises a recorded warning (never a block) so R1 (over-heavy pipeline) is watched with data, not vibes. (env: PAQAD_SPEC_PIPELINE_TOKEN_CEILING)
# spec_pipeline_token_ceiling=40000
# feature-development/specification.yaml: pipeline.grounding_timeout_ms
# Milliseconds `spec pipeline start` gives retrieval to ground the request. Past it, or with an empty index or no embedding key, start grounds on the docs alone and records grounding.mode=lexical-fallback with the reason. (env: PAQAD_SPEC_GROUNDING_BUDGET_MS)
# spec_grounding_budget_ms=15000
# feature-development/specification.yaml: experts.enabled
# The expert roster: a fast-tier skill decides which experts (db, security, ui, ...) a request needs, and their notes feed the crafted spec. On by default on the graduated and full lanes. Set it to false to switch it off: then zero Phase 2 code runs and a pipeline run is byte-identical to v1 (P2-INV-1). Needs spec_pipeline_enabled on to have any effect. (env: PAQAD_SPEC_PIPELINE_EXPERTS_ENABLED)
# spec_pipeline_experts_enabled=true
# feature-development/specification.yaml: hand_written_specs
# warn | strict: how firmly the specification stage adopts the pipeline once spec_pipeline_enabled is on. strict (the default): `spec freeze` refuses a spec the pipeline did not produce; the only exit is `--manual --reason "<why>"`, which is recorded on the frozen spec. Set it to warn to soften this: the stage still tells the agent to produce the spec through `paqad-ai spec pipeline`, but a hand-written spec freezes, recorded as pipeline.produced=false and shown in the receipt. No effect while spec_pipeline_enabled is off. (env: PAQAD_SPEC_PIPELINE_ADOPTION)
# spec_pipeline_adoption=strict
# feature-development/specification.yaml: experts.standing_on_lanes
# Comma-separated lanes (graduated, full) on which the standing experts sit at every spec. On other pipeline lanes only the on-call experts the detector names are seated, plus security-auditor when a planned path is sensitive, and the High Table is skipped when nobody is named. Default: full. Set graduated,full to restore the old behaviour. full is always included. Review is unaffected. (env: PAQAD_SPEC_PIPELINE_EXPERTS_LANES)
# spec_pipeline_experts_lanes=full
# feature-development/specification.yaml: experts.standing
# Comma-separated expert roles that sit at the table on EVERY spec run once spec_pipeline_experts_enabled is on, whatever the detector picked. Default: product-owner,application-architect,user-flow-writer,qa-engineer. The other experts stay on call and are picked per request. Empty means no standing experts (the detector alone decides, as before). A role outside the expert roster is ignored with a doctor warning. No effect while the pipeline or the experts are off. (env: PAQAD_SPEC_PIPELINE_STANDING_EXPERTS)
# spec_pipeline_standing_experts=product-owner,application-architect,user-flow-writer,qa-engineer

# ── feature-development/rules.yaml ──────────────────────────
# feature-development/rules.yaml: loading
# Token-neutral rule loading. ON (default) delivers the lean rule contract (manifest + only the rule text that applies to the files in play) and lifts the full-load mandate. OFF restores loading docs/instructions/rules in full every session. (env: PAQAD_LEAN_RULES)
# lean_rules=true
# feature-development/rules.yaml: enforcement
# off | warn | strict — scripted-rule enforcement from the working tree. (env: PAQAD_RULE_COMPLIANCE)
# rule_compliance=warn
# feature-development/rules.yaml: before_edit.run
# blocking-only | all — rule scripts run before an edit. blocking-only runs only the deterministic changed-files scripts and the rest at turn end; all runs every script. (env: PAQAD_RULE_GATE_PRE_EDIT)
# rule_gate_pre_edit=blocking-only
# feature-development/rules.yaml: max_parallel
# auto | 1-8 — rule scripts run at once. auto = CPU cores minus one, at most 8; 1 runs them one after another. (env: PAQAD_RULE_GATE_CONCURRENCY)
# rule_gate_concurrency=auto
# feature-development/rules.yaml: before_edit.budget_ms
# Time in ms (500-9000) the pre-edit rule check may take from the hook start, under both rule_gate_pre_edit values. Past it the edit goes ahead and the checks block at turn end. (env: PAQAD_RULE_GATE_BUDGET_MS)
# rule_gate_budget_ms=6000

# ── feature-development/reuse.yaml ──────────────────────────
# feature-development/reuse.yaml: existing_code_digest.max_tokens
# Token budget for the feature-development "Existing surface" planning digest (existing symbols the model should reuse). Cards drop by rank past this budget. (env: PAQAD_EXISTING_SURFACE_TOKENS)
# existing_surface_tokens=1000
# feature-development/reuse.yaml: duplication.gate
# off | warn | strict — new-code duplication gate. warn (default) flags a near-copy of existing code; strict blocks it. Ships warn for a two-cycle bake-in. (env: PAQAD_DUPLICATION_MODE)
# duplication_mode=warn
# feature-development/reuse.yaml: duplication.min_similarity
# Minimum similarity (0..1) for a blocking duplication finding. Default 0.90 — conservative, precision over recall. The 0.80–0.90 band routes to review, never blocks. (env: PAQAD_DUPLICATION_SIMILARITY_THRESHOLD)
# duplication_similarity_threshold=0.9
# feature-development/reuse.yaml: duplication.min_lines
# Minimum meaningful-line span a new code block must have to be scored for duplication. Default 8 — shorter snippets are never flagged. (env: PAQAD_DUPLICATION_MIN_LINES)
# duplication_min_lines=8
# feature-development/reuse.yaml: create_vs_reuse.pause
# off | warn | strict — arm the create-vs-reuse decision pause from evidence. warn (default) reports the fork; strict opens a pause that blocks edits until answered. (env: PAQAD_DECISION_ARM_MODE)
# decision_arm_mode=warn
# feature-development/reuse.yaml: create_vs_reuse.min_similarity
# Minimum name similarity (0..1) between a planned new construct and an existing symbol before it counts as a reuse fork. Default 0.85. (env: PAQAD_DECISION_ARM_PLAN_THRESHOLD)
# decision_arm_plan_threshold=0.85
# feature-development/reuse.yaml: create_vs_reuse.max_pauses_per_change
# How many evidence-armed decision pauses one change may open. Default 1 — only the strongest fork is asked; the rest are reported as warnings. (env: PAQAD_DECISION_ARM_MAX_PER_CHANGE)
# decision_arm_max_per_change=1

# ── feature-development/safety.yaml ─────────────────────────
# feature-development/safety.yaml: database_review_for_migrations
# Require a database review when a change includes migrations. (env: PAQAD_REQUIRE_DB_REVIEW_FOR_MIGRATIONS)
# require_db_review_for_migrations=true
# feature-development/safety.yaml: destructive_operations
# block | require_approval | warn — for destructive operations. (env: PAQAD_ESCALATE_DESTRUCTIVE_OPERATIONS)
# escalate_destructive_operations=block
# feature-development/safety.yaml: risky_migrations
# block | require_approval | warn — for risky migrations. (env: PAQAD_ESCALATE_RISKY_MIGRATIONS)
# escalate_risky_migrations=warn
# feature-development/safety.yaml: security_findings
# block | require_approval | warn — for security findings. (env: PAQAD_ESCALATE_SECURITY_FINDINGS)
# escalate_security_findings=block
# feature-development/safety.yaml: large_data_change_rows
# Row count above which a data operation escalates. (env: PAQAD_ESCALATE_DB_ROW_THRESHOLD)
# escalate_db_row_threshold=10000

# ── feature-development/checks.yaml ─────────────────────────
# feature-development/checks.yaml: parallel
# Run the checks stage concurrently and use the test runner's own parallel mode when the project has it. OFF restores the one-after-another run. (env: PAQAD_CHECKS_PARALLEL)
# checks_parallel=true
# feature-development/checks.yaml: max_processes
# Cap on parallel test processes. 0 = auto (cores minus one, capped by memory and container limits). (env: PAQAD_CHECKS_MAX_PROCESSES)
# checks_max_processes=0
# feature-development/checks.yaml: mutation_testing
# off | warn | strict: mutation testing on changed code. Opt-in: off by default. It runs only where the project calls runtime/scripts/verify-backstop.mjs from its own CI or pre-push hook, never at the end of an agent turn, and the project supplies the mutation tool for its stack. The project test command runs first; a red suite reads did not run. warn: a surviving mutant reads Inconclusive. strict: it fails the check. (env: PAQAD_MUTATION_MODE)
# mutation_mode=off
# feature-development/checks.yaml: flaky_tests
# pass | warn | fail — what a test that fails in the parallel run but passes alone does. warn (default): never blocks, recorded, one receipt line. pass: recorded only. fail: blocks. Team value is the floor; local/env may only raise it. (env: PAQAD_CHECKS_FLAKY_UNDER_PARALLEL)
# checks_flaky_under_parallel=warn

# ── feature-development/evidence.yaml ───────────────────────
# feature-development/evidence.yaml: enterprise.enabled
# Master switch for the enterprise/governance capabilities. (env: PAQAD_ENTERPRISE)
# enterprise=false
# feature-development/evidence.yaml: enterprise.ledger
# Write the receipt + evidence ledger set under .paqad/ledger/. (env: PAQAD_ENTERPRISE_EVIDENCE_LEDGER)
# enterprise_evidence_ledger=false
# feature-development/evidence.yaml: enterprise.ai_bom
# Write the CycloneDX ai-bom.json view. (env: PAQAD_ENTERPRISE_AI_BOM)
# enterprise_ai_bom=false
# feature-development/evidence.yaml: enterprise.compliance_citations
# Resolve framework citations into the receipt (token-spending path). (env: PAQAD_ENTERPRISE_COMPLIANCE_CITATIONS)
# enterprise_compliance_citations=false
# feature-development/evidence.yaml: screenshots.enabled
# Capture screenshots of documented flows for frontend changes as feature-bundle evidence. ON also requires the coding capability at its consumers. (env: PAQAD_VISUAL_EVIDENCE)
# visual_evidence=false
# feature-development/evidence.yaml: report
# Render a per-feature evidence report.html from the bundle at end-of-change. ON (default) is local, free, and zero-LLM. OFF stops writing the page. (env: PAQAD_FEATURE_REPORT)
# feature_report=true
# feature-development/evidence.yaml: change_metrics
# Compute the per-change shape metrics (duplication on new code + cross-file reuse rate) and surface them on the receipt, ledger, and dashboard. ON (default) is local, deterministic, and zero-LLM — it folds over caches the gates already produced. OFF stops computing and recording them. (env: PAQAD_METRICS_ENABLED)
# metrics_enabled=true
# feature-development/evidence.yaml: bundle
# off | warn | strict — end-of-change check that a feature-development bundle carries every required file (feature.json / plan / spec / review / stage-evidence / delivery, plus the flag-gated rule-run / change-metrics / duplication / report / rag / receipt / evidence / ai-bom). strict (default) FAILS the change when a required file is missing/empty/invalid, naming the file and its writer; warn surfaces it as Inconclusive without blocking; off falls back to the deprecated evidence_existence_gate. (env: PAQAD_BUNDLE_COMPLETENESS)
# bundle_completeness=strict
# feature-development/evidence.yaml: screenshots.gate
# warn | strict — how firmly the visual-evidence gate enforces once visual_evidence is on and a change is frontend-triggering. warn (default): an environmental miss (browser not provisioned, app not reachable, a failed selector, an absent/partial manifest) reads Inconclusive without blocking. strict: the same misses FAIL the change, and so does a frontend change with nothing captured because no documented flow or capture script exists, unless you attach screenshots (paqad-ai visual-evidence attach) or record a waiver decision (the gate prints the exact decision command). Under warn those skips stay skipped and show a skip line. Team value is the floor; local/env may only raise warn to strict. (env: PAQAD_VISUAL_EVIDENCE_MODE)
# visual_evidence_mode=warn
# feature-development/evidence.yaml: legacy_existence_check
# DEPRECATED: superseded by bundle_completeness, which covers every bundle file and can fail. This warn-only check (rule-run / duplication / change-metrics / rag) now runs ONLY when bundle_completeness=off. warn (default) backfills the recoverable ones from the caches and reports an unrecoverable RAG gap as Inconclusive; it NEVER blocks. off disables it. (env: PAQAD_EVIDENCE_EXISTENCE_GATE)
# evidence_existence_gate=warn

# ── feature-development/analytics.yaml ──────────────────────
# feature-development/analytics.yaml: enabled
# Opt in to complementary analytics instrumentation. OFF (default) is silent; ON authorizes wiring tracking + a per-event tracking-plan doc. (env: PAQAD_ANALYTICS_INSTRUMENTATION)
# analytics_instrumentation=false
# feature-development/analytics.yaml: gate
# off | warn | strict — analytics instrumentation completeness. warn (default) flags a missing event doc; strict blocks on Done; opt-in, never auto-escalated. (env: PAQAD_ANALYTICS_STRICTNESS)
# analytics_strictness=warn

# ── git-workflow/commits.yaml ───────────────────────────────
# git-workflow/commits.yaml: ai_attribution
# keep | strip — what happens to the CODING AGENT vendor attribution on your commits and PRs. strip (default) suppresses it where the provider exposes a project-level knob (Claude Code, Aider) and warns at delivery where it does not (Codex, Cursor are user-level only). paqad's own delivery footer is never touched by this knob. (env: PAQAD_AI_ATTRIBUTION)
# ai_attribution=strip
